# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=BusinessAnalystAgent
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# LLM (OpenRouter — GPT models)
# https://openrouter.ai/keys
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/business_analyst
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ──────────────────────────────────────────────
# Agent
# ──────────────────────────────────────────────
AGENT_RECURSION_LIMIT=15
AGENT_MAX_MESSAGES=20
AGENT_TOOL_TIMEOUT=30

# ──────────────────────────────────────────────
# RAG (ChromaDB)
# ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=business_analyst_docs
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# ──────────────────────────────────────────────
# Data Analysis
# ──────────────────────────────────────────────
MAX_DATASET_ROWS=50000
MAX_UPLOAD_SIZE_MB=50

# ──────────────────────────────────────────────
# Circuit Breaker
# ──────────────────────────────────────────────
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
CB_HALF_OPEN_MAX_CALLS=3

# ──────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
